{
  "version": "2.0.0",
  "tasks": [
    // ── 生成 Prisma Client（schema 变更后首次启动会自动触发）──
    {
      "label": "prisma: generate",
      "type": "shell",
      "command": "prisma",
      "args": [
        "generate",
        "--schema=${workspaceFolder}/litellm/proxy/schema.prisma"
      ],
      "options": {
        "env": {
          "HTTP_PROXY": "http://10.34.6.157:3128",
          "HTTPS_PROXY": "http://10.34.6.157:3128",
          "http_proxy": "http://10.34.6.157:3128",
          "https_proxy": "http://10.34.6.157:3128"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": false
      },
      "problemMatcher": []
    },

    // tag 从 pep-cd yaml 中动态读取，每次启动自动 git pull pep-cd 拿最新版本
    {
      "label": "check-tag: Dev",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/.vscode/check-tag.sh",
        "${workspaceFolder}/../pep-cd/llm-api-gateway/dev.yaml"
      ],
      "dependsOn": ["prisma: generate"],
      "dependsOrder": "sequence",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    },
    /* ⛔ 停用并保留(勿删):
       · check-tag: Prod —— Backend Prod 配置已注释,无人引用
       · ui: build —— 当前走 npm run dev 热更新,没有配置用它把 UI 打进后端静态;需要时再启用
    {
      "label": "check-tag: Prod",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/.vscode/check-tag.sh",
        "${workspaceFolder}/../pep-cd/llm-api-gateway/prod.yaml"
      ],
      "dependsOn": ["prisma: generate"],
      "dependsOrder": "sequence",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    },

    // ──────────────────────────────────────────────────────────────
    //  前端 build — 编译 Next.js 并更新 _experimental/out/
    //  后端启动前自动触发，确保 UI 改动生效
    // ──────────────────────────────────────────────────────────────
    {
      "label": "ui: build",
      "type": "shell",
      "command": "npm run build && cp -r out/* ${workspaceFolder}/litellm/proxy/_experimental/out/",
      "options": {
        "cwd": "${workspaceFolder}/ui/litellm-dashboard",
        "env": {
          "HTTP_PROXY": "http://10.34.6.157:3128",
          "HTTPS_PROXY": "http://10.34.6.157:3128",
          "http_proxy": "http://10.34.6.157:3128",
          "https_proxy": "http://10.34.6.157:3128",
          "NO_PROXY": "localhost,127.0.0.1",
          "no_proxy": "localhost,127.0.0.1"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    */

    /* ⛔ 这两个 shell 后端 task 已停用并保留(勿删):
       改用 launch.json 的 debugpy 后端配置 + compound 一键起前后端(后端可断点),
       不再用 shell 方式起后端;env 已迁移到对应 debugpy 配置
    // ──────────────────────────────────────────────────────────────
    //  后端 A — 连【线上 dev 库】(华为云 litellm_dev)，本地 port 4000
    //  端口 4000 = 前端 networking.tsx 默认值；连共享 dev 库，用默认迁移行为
    //  (如分支比库新缺列，手动应用对应迁移即可，勿让本地随意改共享库 schema)
    //  作为组合配置 "Dev test (后端连线上 dev 库)" 的 preLaunchTask
    // ──────────────────────────────────────────────────────────────
    {
      "label": "backend: online dev DB (port 4000)",
      "type": "shell",
      "command": "python3 -m litellm.proxy.proxy_cli --config ${workspaceFolder}/.vscode/proxy_config.dev.yaml --port 4000",
      "dependsOn": ["prisma: generate"],
      "dependsOrder": "sequence",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DATABASE_URL": "postgresql://root:DDInfraABPP%40ss%23%40!@963dcb2e63e249428847c22a5ca528d2in03.internal.cn-east-3.postgresql.rds.myhuaweicloud.com:5432/litellm_dev",
          "LITELLM_MASTER_KEY": "sk-VinoeroRitur2KL1MAgm",
          "LITELLM_SALT_KEY": "sk-oKs",
          "LITELLM_MODE": "PRODUCTION",
          "STORE_MODEL_IN_DB": "True",
          "REDIS_HOST": "redis-1dd891fe-05bb-4930-847c-af64294ee046.cn-east-3.dcs.myhuaweicloud.com",
          "REDIS_PORT": "6379",
          "REDIS_PASSWORD": "DDInfraProdP@ss",
          "TZ": "Asia/Shanghai",
          "AZURE_OPENAI_API_KEY": "4fd7a6b53efb444e914dcee1339fe778",
          "VOLCENGINE_API_KEY": "5357d45f-f888-484f-b7ef-3f426f4dcc1a",
          "HTTP_PROXY": "http://10.34.6.157:3128",
          "HTTPS_PROXY": "http://10.34.6.157:3128",
          "http_proxy": "http://10.34.6.157:3128",
          "https_proxy": "http://10.34.6.157:3128",
          "NO_PROXY": "localhost,127.0.0.1,172.0.0.0/8,.local,dify-sandbox,.momenta.works,10.0.0.0/8,.deepseek.com,.azure.com,.aliyuncs.com,.volces.com,.ivolces.com,.myhuaweicloud.com,10.251.17.49,10.251.18.82,10.22.5.20,10.251.18.138,.openrouter.ai",
          "no_proxy": "localhost,127.0.0.1,172.0.0.0/8,.local,dify-sandbox,.momenta.works,10.0.0.0/8,.deepseek.com,.azure.com,.aliyuncs.com,.volces.com,.ivolces.com,.myhuaweicloud.com,10.251.17.49,10.251.18.82,10.22.5.20,10.251.18.138,.openrouter.ai"
        }
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": {
        "owner": "litellm-dev",
        "pattern": {
          "regexp": ".",
          "line": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^INFO:\\s+Started",
          "endsPattern": "^INFO:\\s+Application startup complete\\."
        }
      }
    },

    // ──────────────────────────────────────────────────────────────
    //  后端 B — 连【本地库】(localhost:5432 PG + localhost:6379 Redis)
    //  纯本地开发；schema 必须用 `prisma db push` 同步(后端自带的 migrate 落后于
    //  schema.prisma，会漏列如 search_tools/blocked/env_vars)，故启动设
    //  DISABLE_SCHEMA_UPDATE=true 跳过那套落后的 migrate
    //  作为组合配置 "Dev test (后端连本地库)" 的 preLaunchTask
    //  ⚠️ 需先: docker compose -f .local_dev/docker-compose.yml up -d
    //         且 DATABASE_URL=本地 prisma db push --schema litellm/proxy/schema.prisma
    // ──────────────────────────────────────────────────────────────
    {
      "label": "backend: local DB (port 4000)",
      "type": "shell",
      "command": "python3 -m litellm.proxy.proxy_cli --config ${workspaceFolder}/.vscode/proxy_config.dev.yaml --port 4000",
      "dependsOn": ["prisma: generate"],
      "dependsOrder": "sequence",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DATABASE_URL": "postgresql://postgres:dev@localhost:5432/litellm_dev",
          "DISABLE_SCHEMA_UPDATE": "true",
          "LITELLM_MASTER_KEY": "sk-VinoeroRitur2KL1MAgm",
          "LITELLM_SALT_KEY": "sk-oKs",
          "LITELLM_MODE": "PRODUCTION",
          "STORE_MODEL_IN_DB": "True",
          "REDIS_HOST": "localhost",
          "REDIS_PORT": "6379",
          "TZ": "Asia/Shanghai",
          "AZURE_OPENAI_API_KEY": "4fd7a6b53efb444e914dcee1339fe778",
          "VOLCENGINE_API_KEY": "5357d45f-f888-484f-b7ef-3f426f4dcc1a",
          "HTTP_PROXY": "http://10.34.6.157:3128",
          "HTTPS_PROXY": "http://10.34.6.157:3128",
          "http_proxy": "http://10.34.6.157:3128",
          "https_proxy": "http://10.34.6.157:3128",
          "NO_PROXY": "localhost,127.0.0.1,172.0.0.0/8,.local,dify-sandbox,.momenta.works,10.0.0.0/8,.deepseek.com,.azure.com,.aliyuncs.com,.volces.com,.ivolces.com,.myhuaweicloud.com,10.251.17.49,10.251.18.82,10.22.5.20,10.251.18.138,.openrouter.ai",
          "no_proxy": "localhost,127.0.0.1,172.0.0.0/8,.local,dify-sandbox,.momenta.works,10.0.0.0/8,.deepseek.com,.azure.com,.aliyuncs.com,.volces.com,.ivolces.com,.myhuaweicloud.com,10.251.17.49,10.251.18.82,10.22.5.20,10.251.18.138,.openrouter.ai"
        }
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": {
        "owner": "litellm-local",
        "pattern": {
          "regexp": ".",
          "line": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^INFO:\\s+Started",
          "endsPattern": "^INFO:\\s+Application startup complete\\."
        }
      }
    },
    */

    // ──────────────────────────────────────────────────────────────
    //  本地库 schema 同步 — 切到含新列的分支后,手动跑一次(Terminal → Run Task)
    //  按 schema.prisma 同步本地库,补齐后端自带 migrate 漏掉的新列
    //  (db push 是 additive,不会删数据;启动仍用 DISABLE_SCHEMA_UPDATE)
    //  ⚠️ 需本地 PG 在跑: docker compose -f .local_dev/docker-compose.yml up -d
    // ──────────────────────────────────────────────────────────────
    {
      "label": "local DB: db push (sync schema)",
      "type": "shell",
      "command": "python3 -m prisma db push --schema ${workspaceFolder}/litellm/proxy/schema.prisma --accept-data-loss --skip-generate",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DATABASE_URL": "postgresql://postgres:dev@localhost:5432/litellm_dev"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    }

    /* ⛔ 线上 K8s port-forward（dev/prod 集群）暂时停用：太不稳定，先注释保留，勿删
    // ──────────────────────────────────────────────────────────────
    //  kubectl port-forward — K8s Dev
    //  将 pep-dev/llm-api-gateway:4000 映射到本地 4001
    //  context: web-dev-a  namespace: pep-dev
    // ──────────────────────────────────────────────────────────────
    {
      "label": "port-forward: K8s Dev",
      "type": "shell",
      "command": "kubectl --context web-dev-a port-forward -n pep-dev svc/llm-api-gateway 4001:4000",
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": {
        "owner": "kubectl-pf-dev",
        "pattern": {
          "regexp": "^Forwarding from .* -> (\\d+)$",
          "line": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Forwarding from 127\\.0\\.0\\.1:4001",
          "endsPattern": "^Forwarding from \\[::"
        }
      }
    },

    // ──────────────────────────────────────────────────────────────
    //  kubectl port-forward — K8s Prod
    //  将 pep-prod/llm-api-gateway:4000 映射到本地 4002
    //  context: web-a  namespace: pep-prod
    // ──────────────────────────────────────────────────────────────
    {
      "label": "port-forward: K8s Prod",
      "type": "shell",
      "command": "kubectl --context web-a port-forward -n pep-prod svc/llm-api-gateway 4002:4000",
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": {
        "owner": "kubectl-pf-prod",
        "pattern": {
          "regexp": "^Forwarding from .* -> (\\d+)$",
          "line": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Forwarding from 127\\.0\\.0\\.1:4002",
          "endsPattern": "^Forwarding from \\[::"
        }
      }
    }
    */
  ]
}
