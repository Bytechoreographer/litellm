    //  后端(debug,可断点) · 连【本地库】(localhost PG + Redis)
    //  纯本地开发,无 check-tag;DISABLE_SCHEMA_UPDATE 跳过迁移(schema 由 db push 管)
    //  ⚠️ 需先 docker compose -f .local_dev/docker-compose.yml up -d 且已 db push
    // ──────────────────────────────────────────────────────────────
    {
      "name": "后端(debug,可断点) · 连本地库 localhost(PG+Redis)",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "prisma: generate",
      "module": "litellm.proxy.proxy_cli",
      "args": ["--config", "${workspaceFolder}/.vscode/proxy_config.dev.yaml", "--port", "4000"],
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "DATABASE_URL": "postgresql://postgres:dev@localhost:5432/litellm_dev",
        "DISABLE_SCHEMA_UPDATE": "true",
        "LITELLM_MASTER_KEY": "sk-VinoeroRitur2KL1MAgm",
        "LITELLM_SALT_KEY": "sk-oKs",
        "LITELLM_MODE": "PRODUCTION",
        "STORE_MODEL_IN_DB": "True",
